# Copy this file to ".env" and fill in the values. NEVER commit .env to Git.

# Run `python generate_keys.py` to create these two:
SECRET_KEY=
FILE_ENCRYPTION_KEY=

# Firebase Console > Project settings > General > Web API Key
FIREBASE_WEB_API_KEY=

# Firebase Console > Storage (bucket name, e.g. my-project.appspot.com)
FIREBASE_STORAGE_BUCKET=

# Path to the service-account JSON (Project settings > Service accounts > Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

MAX_UPLOAD_MB=25
# Set to "production" when deployed behind HTTPS
FLASK_ENV=development
